{
    "name": "phasync/http-client",
    "description": "An async PSR-18 HTTP Client implementation.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "phasync\\HttpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "phasync\\HttpClient\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "phasync/phasync": "^2.0.0-alpha24",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.34 || ^3.0",
        "friendsofphp/php-cs-fixer": "^3.59"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest"
    }
}
